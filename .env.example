# Optional settings (copy to .env)
LOANLENS_PROFILE=freddie          # freddie (real data) | tiny (tests)
FRED_API_KEY=                     # official FRED API; blank = public fredgraph.csv endpoint
LOANLENS_ALERT_WEBHOOK=           # Slack/Teams incoming-webhook URL for pipeline alerts
LOANLENS_POSTGRES_DSN=postgresql://loanlens:loanlens@localhost:5432/loanlens
